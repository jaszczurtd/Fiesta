{
  "$schema": "../JaszczurHAL/config/hardware/device_tree.schema.json",
  "schemaVersion": 1,
  "nodes": {
    "can": { "compatible": "microchip,mcp2515" },
    "egtPreDpf": { "compatible": "jaszczurhal,i2c-device" },
    "egtMidDpf": { "compatible": "jaszczurhal,i2c-device" },
    "oilPressure": { "compatible": "jaszczurhal,adc-input" },
    "absSpeed": { "compatible": "jaszczurhal,gpio-input" }
  },
  "assemblies": {
    "rp2040-zero": {
      "target": "rp2040",
      "board": "rp2040-zero",
      "clock": { "tree": "default" },
      "statusLed": { "node": "board.statusLed", "pixelOrder": "GRB" },
      "buses": {
        "spi": {
          "kind": "spi",
          "index": 0,
          "frequencyHz": 10000000,
          "pins": { "sck": 2, "mosi": 3, "miso": 0 }
        },
        "i2c": {
          "kind": "i2c",
          "index": 0,
          "frequencyHz": 100000,
          "pins": { "sda": 12, "scl": 13 }
        }
      },
      "nodes": {
        "can": { "present": true, "bus": "spi", "pins": { "cs": 1, "int": 4 } },
        "egtPreDpf": { "present": true, "bus": "i2c", "address": 96 },
        "egtMidDpf": { "present": true, "bus": "i2c", "address": 103 },
        "oilPressure": { "present": true, "pins": { "in": 29 } },
        "absSpeed": { "present": true, "pins": { "in": 14 } }
      }
    }
  }
}
