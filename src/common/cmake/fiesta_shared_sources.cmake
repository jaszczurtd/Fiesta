# Shared translation units for host builds and firmware manifest generation.
# Each set owns one <name>_sources.txt beside its sources.
if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    cmake_minimum_required(VERSION 3.16)
endif()
set(FIESTA_SHARED_SOURCE_SETS vp37 test_runner obdDefinitions)
get_filename_component(FIESTA_SHARED_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

function(fiesta_shared_sources output root name)
    if(NOT name IN_LIST FIESTA_SHARED_SOURCE_SETS)
        message(FATAL_ERROR "Unknown shared source set: ${name}")
    endif()
    set(directory "${root}/src/common/${name}")
    set(listing "${directory}/${name}_sources.txt")
    file(STRINGS "${listing}" lines)
    set(sources "")
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        if(line STREQUAL "" OR line MATCHES "^#")
            continue()
        endif()
        if(NOT line MATCHES "^[A-Za-z0-9_]+\\.(c|cpp)$")
            message(FATAL_ERROR "${listing}: invalid source name: ${line}")
        endif()
        if(NOT EXISTS "${directory}/${line}")
            message(FATAL_ERROR "${listing}: missing ${line}")
        endif()
        if("${directory}/${line}" IN_LIST sources)
            message(FATAL_ERROR "${listing}: duplicate ${line}")
        endif()
        list(APPEND sources "${directory}/${line}")
    endforeach()
    file(GLOB actual "${directory}/*.c" "${directory}/*.cpp")
    foreach(path IN LISTS actual)
        if(NOT path IN_LIST sources)
            message(FATAL_ERROR "${listing}: unlisted source ${path}")
        endif()
    endforeach()
    set(${output} "${sources}" PARENT_SCOPE)
endfunction()

# The Python registry delegates this part of the migration to CMake. Output
# contains only newline-separated results; diagnostics go to stderr.
if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(FIESTA_SHARED_QUERY STREQUAL "sets")
        set(result "${FIESTA_SHARED_SOURCE_SETS}")
    elseif(FIESTA_SHARED_QUERY STREQUAL "files")
        fiesta_shared_sources(paths "${FIESTA_QUERY_ROOT}" "${FIESTA_QUERY_SET}")
        set(result "")
        foreach(path IN LISTS paths)
            get_filename_component(name "${path}" NAME)
            list(APPEND result "${name}")
        endforeach()
    else()
        message(FATAL_ERROR "Unknown shared source query: ${FIESTA_SHARED_QUERY}")
    endif()
    string(REPLACE ";" "\n" result "${result}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${result}")
endif()
