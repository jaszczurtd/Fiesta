{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Project: Debug Firmware",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/.build/firmware.elf",
            "servertype": "openocd",
            "device": "RP2040",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2040.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "Project: Build (Debug)",
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ]
        },
        {
            "name": "Project: Debug Firmware (RP2350 ARM)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/.build/firmware.elf",
            "servertype": "openocd",
            "device": "RP2350",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "Project: Build (Debug)",
            "openOCDLaunchCommands": [
                "adapter speed 2000"
            ]
        },
        {
            "name": "Project: Debug Firmware (STM32G474 / ST-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/.build/firmware.elf",
            "servertype": "openocd",
            "device": "STM32G474RE",
            "configFiles": [
                "board/st_nucleo_g4.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "Project: Build (Debug)",
            "openOCDLaunchCommands": [
                "reset_config srst_only srst_nogate connect_assert_srst"
            ]
        }
    ]
}
