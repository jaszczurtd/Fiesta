{
    "$schema": "../../JaszczurHAL/vscode/schema/jh_vscode_project.schema.json",
    "project": "Fiesta",
    "module": "ECU",
    "toolchain": "cmake",
    "target": "rp2040",
    "board": "rp2040-plus-4mb",
    "buildDir": "${project}/.build",
    "cmakeBuildDir": "${buildDir}/cmake",
    "cmake": {
        "sourceDir": "${project}/../JaszczurHAL/cmake/jh_firmware_project",
        "cache": {
            "JH_PROJECT_DIR": "${project}",
            "JH_MODULE_NAME": "ECU",
            "JH_EXTRA_DEFINES": "ECU_FUNCTIONAL_TESTS_ENABLED=0",
            "JH_EXTRA_SOURCES": "../common/vp37/vp37.c;../common/vp37/vp37_adjustometer.c;../common/vp37/vp37_snapshot.c;../common/vp37/vp37_tuning.c;../common/vp37/vp37_feedback.c;../common/vp37/vp37_compensation.c;../common/vp37/vp37_control.c;../common/vp37/vp37_telemetry.c;../common/vp37/vp37_current.c;../common/vp37/vp37_current_control.c;../common/vp37/vp37_maps.c"
        },
        "targets": {
            "build": "firmware",
            "buildDebug": "firmware_debug",
            "upload": "firmware_upload",
            "compileDb": "firmware_compile_db"
        }
    },
    "variants": [
        {
            "id": "bench",
            "module": "ECU",
            "extraDefines": [
                "ECU_FUNCTIONAL_TESTS_ENABLED=1"
            ]
        }
    ],
    "identity": {
        "enabled": true,
        "usbManufacturer": "Jaszczur",
        "usbProduct": "Fiesta ECU",
        "usbVid": "0x2e8a",
        "usbPid": "0x000a",
        "byIdHint": "Fiesta_ECU"
    },
    "artifacts": {
        "elf": "${buildDir}/firmware.elf",
        "uf2": "${buildDir}/firmware.uf2",
        "compileCommands": "${buildDir}/compile_commands_patched.json"
    },
    "upload": {
        "strategy": "serial"
    }
}
