# Fontconfig configuration parsed through expat. The number of fontconfig and
# expat frames varies by build (three and five on ubuntu-24.04 x86_64, four and
# five on Debian bookworm arm64), and with the default 12-frame stack the
# frames after XML_ParseBuffer may be cut off.
{
   fontconfig-expat-process-leak
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   obj:*/libfontconfig.so*
   obj:*/libfontconfig.so*
   obj:*/libfontconfig.so*
   ...
   obj:*/libexpat.so*
   ...
   fun:XML_ParseBuffer
}

{
   gtk4-gio-init-io-module-scan-leak
   Memcheck:Leak
   match-leak-kinds: definite
   fun:calloc
   fun:g_malloc0
   ...
   fun:g_io_modules_scan_all_in_directory_with_scope
   ...
   fun:gtk_init_check
}

# XVisualInfo list that GTK 4.8 (Debian bookworm) does not free while it
# prepares GL on an X11 display such as Xvfb.
{
   gtk4-x11-gl-visual-info
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   fun:XGetVisualInfo
   ...
   fun:gdk_display_prepare_gl
   fun:gdk_x11_display_open
}

# glibc dependency list (l_initfini) of a module loaded by dlopen(); on the
# GitHub ubuntu-24.04 runner gtk_init loads the dconf GIO module this way.
# The default 12-frame stack ends in dlopen, so only the loader frames match.
{
   glibc-dlopen-dependency-list
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   ...
   fun:_dl_map_object_deps
   fun:dl_open_worker_begin
}

# Fontconfig/Pango font matching caches: upstream GNOME/pango pango.supp.
# These match only definite leaks inside the system font libraries.
{
  sc_system_fontconfig_render_prepare
  Memcheck:Leak
  match-leak-kinds: definite
  fun:realloc
  obj:*libfontconfig.so*
  obj:*libfontconfig.so*
  fun:FcFontRenderPrepare
}
{
  sc_system_pango_cairo_fontconfig_substitution
  Memcheck:Leak
  match-leak-kinds: definite
  fun:realloc
  obj:*libfontconfig.so*
  obj:*libfontconfig.so*
  obj:*libcairo.so*
  obj:*libpangocairo-1.0.so*
}
