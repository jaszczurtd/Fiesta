{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "boardSelection",
      "description": "Target/board",
      "type": "pickString",
      "options": [
        "rp2040:pico - Raspberry Pi Pico",
        "rp2040:pico-rm2 - Raspberry Pi Pico with PIM730/RM2",
        "rp2040:picow - Raspberry Pi Pico W",
        "rp2040:rp2040-plus-4mb - Waveshare RP2040-Plus 4 MB",
        "rp2040:rp2040-zero - Waveshare RP2040-Zero compatible",
        "rp2350-arm:pico2 - Raspberry Pi Pico 2",
        "rp2350-arm:pico2w - Raspberry Pi Pico 2 W",
        "rp2350-riscv:pico2 - Raspberry Pi Pico 2",
        "stm32g474:nucleo-g474re - ST NUCLEO-G474RE",
        "stm32g474:nucleo-g474re-pim730 - ST NUCLEO-G474RE with PIM730/RM2"
      ],
      "default": "rp2040:rp2040-zero - Waveshare RP2040-Zero compatible"
    }
  ],
  "tasks": [
    {
      "label": "Project: Build",
      "detail": "Compile Clocks through JaszczurHAL VS Code entry",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "build",
        "--project",
        "${workspaceFolder}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Project: Build (Debug)",
      "detail": "Debug build Clocks through JaszczurHAL VS Code entry",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "build-debug",
        "--project",
        "${workspaceFolder}"
      ],
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Project: Upload",
      "detail": "Upload Clocks through the active target backend",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "upload",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": "$gcc"
    },
    {
      "label": "Project: Upload (UF2 / BOOTSEL)",
      "detail": "RP2040 only: build Clocks and copy UF2 to the single visible BOOTSEL drive",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "upload-uf2",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Upload (OTA)",
      "detail": "Build, authenticate, and upload Clocks to a discovered native RP device",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "upload-ota",
        "--project",
        "${workspaceFolder}",
        "--interactive"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Discover OTA devices",
      "detail": "List JaszczurHAL devices advertising native OTA",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "ota-discover",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: List ports",
      "detail": "Show serial ports, identity matches, and BOOTSEL candidates",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "list-ports",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Change port",
      "detail": "Interactively persist the upload/monitor serial port",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "change-port",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Serial Monitor",
      "detail": "Persistent Clocks serial monitor",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "monitor",
        "--project",
        "${workspaceFolder}",
        "--lock-policy",
        "replace-own"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Project: Debug Probe Monitor",
      "detail": "Debug Probe monitor through JaszczurHAL VS Code entry",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "monitor-probe",
        "--project",
        "${workspaceFolder}",
        "--lock-policy",
        "replace-own"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Project: Serial Monitor (Any)",
      "detail": "Any serial monitor through JaszczurHAL VS Code entry",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "monitor-any",
        "--project",
        "${workspaceFolder}",
        "--lock-policy",
        "wait"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Project: Refresh IntelliSense",
      "detail": "Refresh Clocks IntelliSense through JaszczurHAL VS Code entry",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "refresh-intellisense",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Clean",
      "detail": "Clean Clocks build directory",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "clean",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Clear USB Identity",
      "detail": "Flash neutral firmware after verifying current Fiesta Clocks identity",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "clear-identity",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Config Dump",
      "detail": "Show resolved JaszczurHAL VS Code project configuration",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "config-dump",
        "--project",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Select board",
      "detail": "Interactive target/board selection",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "select-board",
        "--project",
        "${workspaceFolder}",
        "--interactive"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Project: Select board (GUI)",
      "detail": "Pick target/board from the VS Code input menu",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "select-board",
        "--project",
        "${workspaceFolder}",
        "--selection",
        "${input:boardSelection}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: Sync board picker",
      "detail": "Refresh target/board options and managed debug profiles",
      "type": "shell",
      "command": "${config:jaszczurhal.vscodeEntry}",
      "windows": {
        "command": "${config:jaszczurhal.vscodeEntryWindows}"
      },
      "args": [
        "sync-board-picker",
        "--project",
        "${workspaceFolder}"
      ],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Project: Configure Git hooks",
      "detail": "Auto-run on folder open - set core.hooksPath to repo .githooks",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "${workspaceFolder}/../../scripts/configure_git_hooks.py"
        ]
      },
      "args": [
        "${workspaceFolder}/../../scripts/configure_git_hooks.py"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": true,
        "reveal": "never",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
