{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Project: Debug rp2040-zero (RP2040)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/.build/rp2040/rp2040-zero/firmware.elf",
            "servertype": "openocd",
            "device": "RP2040",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2040.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "Project: Build (Debug) rp2040-zero",
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ]
        },
        {
            "name": "Project: Debug rp2040-zero variant: TIMING (RP2040)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/.build/rp2040/rp2040-zero/variants/TIMING/firmware.elf",
            "servertype": "openocd",
            "device": "RP2040",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2040.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "Project: Build (Debug) rp2040-zero variant: TIMING",
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ]
        }
    ]
}
